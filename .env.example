# ============================================================
# Supabase
# ============================================================
# Public: exposed to the browser via Vite.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ... # safe to ship to the client

# Server-only: NEVER prefix with VITE_. The service-role key bypasses RLS,
# so it must never end up in the browser bundle. Only referenced from api/.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# LLM provider (A4.1 — cross-provider abstraction)
# ============================================================
# Primary provider: "openai" (default) or "anthropic".
# Flip this one var in Vercel to switch the entire generation pipeline.
LLM_PROVIDER=openai

# Fallback provider used when the primary returns a rate-limit or 5xx error.
# Auto-detected from whichever API key is present. Set to "none" to disable.
LLM_FALLBACK_PROVIDER=anthropic

# ============================================================
# OpenAI
# ============================================================
# Get one from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# The model used when LLM_PROVIDER=openai (or as OpenAI fallback).
OPENAI_FALLBACK_MODEL=gpt-5.4-mini

# ============================================================
# Anthropic
# ============================================================
# Get one from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used when LLM_PROVIDER=anthropic (or as Anthropic fallback).
# claude-3-5-haiku-20241022 = fastest + cheapest; good for fallback.
# claude-3-5-sonnet-20241022 = higher quality if you want Anthropic as primary.
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ============================================================
# Mapbox (client)
# ============================================================
VITE_MAPBOX_TOKEN=pk.ey...

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins for API requests.
# Set this in Vercel to your production + preview URLs.
# If unset, falls back to * (local dev only — never leave unset in production).
# Example: https://your-app.vercel.app,https://www.example.com
ALLOWED_ORIGINS=

# ============================================================
# Optional
# ============================================================
# Override the API base the frontend talks to. Leave unset in prod - the
# frontend uses a relative /api path by default.
# VITE_API_BASE_URL=https://your-preview.example.com/api

# ============================================================
# Sentry (error tracking) — leave empty to disable silently
# ============================================================
# Frontend DSN (exposed to the browser via Vite).
# Get one from: https://sentry.io → Project Settings → Client Keys (DSN).
# Empty string or unset = Sentry disabled; no errors thrown.
VITE_SENTRY_DSN=

# Backend DSN (server-only, no VITE_ prefix — never shipped to the client).
# Can be the same DSN as above or a separate Sentry project for the API.
# Empty string or unset = Sentry disabled on the backend.
SENTRY_DSN=
