{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "rm -f package-lock.json && npm install",
  "functions": {
    "api/itinerary.ts": {
      "maxDuration": 300
    },
    "api/itinerary/save.ts": {
      "maxDuration": 30
    },
    "api/social/extract.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
